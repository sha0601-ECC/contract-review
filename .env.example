# ============================================================
# Contract Review System - Configuration
# ============================================================
# Copy this file to .env and fill in your values
#   cp .env.example .env
# ============================================================

# -------------------------------------------------------
# Model Mode: "local" or "online"
# -------------------------------------------------------
# local  = Use Ollama running in Docker (privacy-friendly, no data leaves your machine)
# online = Use Claude/OpenAI APIs (requires API keys below)
MODEL_MODE=online

# -------------------------------------------------------
# Local Model (Ollama) - Used when MODEL_MODE=local
# -------------------------------------------------------
# Base URL for Ollama API inside Docker network
OLLAMA_BASE_URL=http://ollama:11434

# Model name - must support vision for image analysis
# Recommended: llama3.2-vision:latest (smallest, vision-capable)
# Other options: llama3.2:latest, mistral:latest, qwen2.5:latest
OLLAMA_MODEL=llama3.2-vision:latest

# To start Ollama manually (outside Docker):
#   docker run -d -p 11434:11434 -v ollama-data:/root/.ollama ollama/ollama:latest
# Then set: OLLAMA_BASE_URL=http://localhost:11434
#
# To pull the vision model:
#   docker-compose run --rm ollama-setup
#   # or
#   python scripts/ollama-reset.py --pull llama3.2-vision:latest

# -------------------------------------------------------
# Online Models - Used when MODEL_MODE=online
# -------------------------------------------------------
# Anthropic API Key (for Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# OpenAI API Key (for GPT-4o)
OPENAI_API_KEY=sk-xxxxx

# Model selection for online mode
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o

# -------------------------------------------------------
# Ollama Management Commands (run from contract-review dir)
# -------------------------------------------------------
# Check if Ollama is running:
#   python scripts/ollama-reset.py --health
#
# List installed models:
#   python scripts/ollama-reset.py --list
#
# Pull/download a model:
#   python scripts/ollama-reset.py --pull llama3.2-vision:latest
#
# Reset (delete + re-pull) a model:
#   python scripts/ollama-reset.py --reset llama3.2-vision:latest
