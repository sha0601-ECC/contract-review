# ============================================================
# Contract Review System - Configuration
# ============================================================
# Copy this file to .env and fill in your values
#   cp .env.example .env
# ============================================================

# -------------------------------------------------------
# Model Provider: claude / deepseek / qwen / kimi / minimax / ollama / openai
# -------------------------------------------------------
MODEL_PROVIDER=claude

# -------------------------------------------------------
# Anthropic (Claude)
# -------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# -------------------------------------------------------
# OpenAI
# -------------------------------------------------------
OPENAI_API_KEY=sk-xxxxx
OPENAI_MODEL=gpt-4o

# -------------------------------------------------------
# DeepSeek
# API: https://api.deepseek.com
# -------------------------------------------------------
DEEPSEEK_API_KEY=sk-xxxxx
DEEPSEEK_MODEL=deepseek-chat

# -------------------------------------------------------
# Alibaba Qwen (DashScope)
# API: https://dashscope.aliyuncs.com/compatible-mode/v1
# -------------------------------------------------------
DASHSCOPE_API_KEY=sk-xxxxx
QWEN_MODEL=qwen-plus

# -------------------------------------------------------
# Moonshot (Kimi)
# API: https://api.moonshot.cn/v1
# -------------------------------------------------------
MOONSHOT_API_KEY=sk-xxxxx
KIMI_MODEL=moonshot-v1-8k

# -------------------------------------------------------
# MiniMax
# API: https://api.minimax.chat/v1
# -------------------------------------------------------
MINIMAX_API_KEY=sk-xxxxx
MINIMAX_MODEL=MiniMax-M2.7

# -------------------------------------------------------
# Ollama (Local)
# -------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2-vision:latest

# -------------------------------------------------------
# Ollama Management Commands
# -------------------------------------------------------
# Check if Ollama is running:
#   python scripts/ollama-reset.py --health
#
# List installed models:
#   python scripts/ollama-reset.py --list
#
# Pull/download a model:
#   python scripts/ollama-reset.py --pull llama3.2-vision:latest
#
# Reset (delete + re-pull) a model:
#   python scripts/ollama-reset.py --reset llama3.2-vision:latest
